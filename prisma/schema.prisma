generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String?
  name                String?
  role                UserRole       @default(USER)
  shouldResetPassword Boolean        @default(false)
  isBlocked           Boolean        @default(false)
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]
  orders              Order[]
  sessions            UserSession[]
  affiliate           Affiliate?
  referredBy          Referral?
}

/// One row per sign-in. Auth uses JWTs (stateless), so without this table a
/// signed-in device is invisible and cannot be revoked. The JWT carries `jti`;
/// a token whose row is missing or revoked is rejected on the next request.
model UserSession {
  id         String    @id @default(cuid())
  jti        String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

enum UserRole {
  USER
  ADMIN
}

model Subscription {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  robotId          String
  robot            Robot       @relation(fields: [robotId], references: [id])
  tier             PricingTier
  status           SubStatus   @default(ACTIVE)
  mt5AccountNumber String? // The MT5 account locked to this EA
  startsAt         DateTime    @default(now())
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  compilations Compilation[]
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String      @default("USD")
  status      OrderStatus @default(PENDING)
  paygateId   String?     @unique
  pricingTier PricingTier
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  commission Commission?
}

model Robot {
  id               String   @id @default(cuid())
  slug             String   @unique // "goldbot" — join key for Blob path (sources/<slug>/) + compiled filename
  name             String // "GoldBot" — display name
  shortDescription String // catalog card copy
  longDescription  String   @db.Text // detail-page copy — Postgres text, avoids varchar cap
  active           Boolean  @default(true) // catalog visibility flag
  artworkUrl       String? // nullable until artwork asset exists
  badge            String? // short label on the catalog card + robot page, e.g. "Prop firm compatible"
  sortOrder        Int      @default(0) // catalog ordering
  sourceVersion    Int      @default(1) // which sources/<slug>/v<N>.mq5.enc is current
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions Subscription[]
  compilations  Compilation[]
  prices        RobotPrice[]
  coupons       Coupon[]

  @@index([active, sortOrder]) // catalog list query: where active order by sortOrder
}

model RobotPrice {
  id        String      @id @default(cuid())
  robotId   String
  robot     Robot       @relation(fields: [robotId], references: [id], onDelete: Cascade)
  tier      PricingTier
  amount    Float // per-robot price in USD; 0 for FREE_TRIAL
  active    Boolean     @default(true) // hide a tier for one robot without deleting the row
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([robotId, tier]) // one price row per (robot, tier) — gives Prisma the robotId_tier composite
  @@index([robotId, active])
}

model Compilation {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  robotId        String
  robot          Robot         @relation(fields: [robotId], references: [id])
  sourceVersion  Int           @default(1) // denormalized from robot at creation; immutable per job
  status         CompileStatus @default(PENDING)
  downloadUrl    String?

  // Retry + reaper state (Phase 1)
  attemptCount Int       @default(0)
  attemptedAt  DateTime?
  errorMessage String?

  // Upload metadata written by /complete route (Phase 1 direct-to-Blob path)
  sha256    String?
  sizeBytes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([status, attemptedAt])
}

enum PricingTier {
  FREE_TRIAL
  TEN_DAYS // NEW — was silently downgraded to ONE_MONTH
  ONE_MONTH
  SIX_MONTHS
  ONE_YEAR // NEW — was silently downgraded to ONE_MONTH
  LIFETIME
  LIFETIME_SOURCE // NEW — was silently downgraded to ONE_MONTH
  SECRET_TEST_TIER
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CompileStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WorkerHeartbeat {
  id            String   @id // singleton row keyed "compiler"
  lastSeenAt    DateTime
  workerVersion String?
  updatedAt     DateTime @updatedAt
}

/// One row per authenticated Paygate GET callback delivery.
///
/// The `signature` field is the natural per-delivery nonce: it embeds
/// PAYGATE_WEBHOOK_SECRET via HMAC-SHA256 over ${orderRef}${email}${tier}${amount},
/// so it is deterministic per legitimate order but unforgeable without the secret.
/// A `P2002` on insert = this delivery is a replay of a signature we've already
/// processed → webhook GET returns 200 duplicated:true without provisioning.
///
/// Closes SECR-02 (replay rejection) and SECR-03 (idempotency).
model WebhookDelivery {
  id         String   @id @default(cuid())
  signature  String   @unique
  orderRef   String
  receivedAt DateTime @default(now())

  @@index([orderRef])
  @@index([receivedAt]) // supports future cleanup cron (deferred — see 2-RESEARCH.md Open Q 3)
}

/// Marketing email list — populated by the education site
/// (algotradingschool.com) via POST /api/marketing/subscribe.
/// Deliberately NOT related to User: subscribers are pre-customers.
model EmailSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("algotradingschool") // which property captured the lead
  locale         String? // signup-page locale (en/es/de/hi/bn/ur/ar) — gates locale-restricted sequences
  unsubscribedAt DateTime? // one-click unsubscribe (see /api/marketing/unsubscribe); null = subscribed
  createdAt      DateTime  @default(now())

  @@index([createdAt])
}

// ===========================================================================
// Affiliate program
//
// Attribution lives on the USER, not the cookie: someone who clicks a link,
// claims a free trial today and buys three weeks later still pays the
// referrer. The cookie only carries a code long enough to create that link.
// ===========================================================================

/// One row per user who joined the program. `code` is what appears in links.
model Affiliate {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String          @unique // uppercase, link-safe, e.g. "ALX7K2QD"
  status        AffiliateStatus @default(ACTIVE)
  rateOverride  Float? // percent; set per-affiliate, wins over the tier ladder
  payoutMethod  String? // free text: "USDT TRC20", "Wise", …
  payoutAddress String?
  note          String? // admin-only
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  clicks      AffiliateClick[]
  referrals   Referral[]
  commissions Commission[]
  payouts     AffiliatePayout[]

  @@index([status])
}

enum AffiliateStatus {
  ACTIVE
  SUSPENDED
}

/// Admin-editable commission ladder. An affiliate's rate is the highest tier
/// whose threshold their lifetime total (earned or referral count, per
/// AffiliateSettings.tierBasis) has reached.
model AffiliateTier {
  id        String   @id @default(cuid())
  name      String // Bronze / Silver / Gold
  threshold Float // min lifetime commission earned, or min referrals
  rate      Float // percent of order value
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Singleton (id = "default"). Everything an admin can tune without a deploy.
model AffiliateSettings {
  id               String    @id @default("default")
  cookieDays       Int       @default(30)
  tierBasis        TierBasis @default(VOLUME)
  defaultRate      Float     @default(15) // used when no tier matches
  referredDiscount Float     @default(15) // percent off a referred user's FIRST order
  minPayout        Float     @default(50)
  holdDays         Int       @default(14) // matches the refund window
  lifetimeScope    Boolean   @default(true) // earn on every order, not just the first
  blockSelfReferral Boolean  @default(true)
  updatedAt        DateTime  @updatedAt
}

enum TierBasis {
  VOLUME // lifetime commission earned, in dollars
  REFERRALS // number of referred users who bought
}

/// Raw click on a referral link. Kept separate from Referral so the funnel
/// (clicks → signups → sales) is measurable; IPs are hashed, never stored raw.
model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  ipHash      String? // sha256(ip + secret) — for abuse checks, not identification
  userAgent   String?
  referer     String?
  landingPath String?
  country     String?
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
}

/// The attribution record. One per referred user, ever.
model Referral {
  id             String    @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String    @unique
  referredUser   User      @relation(fields: [referredUserId], references: [id], onDelete: Cascade)
  code           String // the code as used, kept even if the affiliate later changes it
  landingPath    String?
  ipHash         String? // signup IP — same hash as the click, for same-device flagging
  createdAt      DateTime  @default(now())

  commissions Commission[]

  @@index([affiliateId, createdAt])
}

/// One per paid order by a referred user. Money is only ever payable after
/// `holdUntil` passes and an admin approves it.
model Commission {
  id             String           @id @default(cuid())
  orderId        String           @unique
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  affiliateId    String
  affiliate      Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referralId     String
  referral       Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  orderAmount    Float
  rate           Float // percent applied, frozen at creation
  amount         Float // orderAmount * rate / 100
  status         CommissionStatus @default(PENDING)
  holdUntil      DateTime
  approvedAt     DateTime?
  paidAt         DateTime?
  payoutId       String?
  payout         AffiliatePayout? @relation(fields: [payoutId], references: [id])
  reversedReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([affiliateId, status])
  @@index([status, holdUntil])
}

enum CommissionStatus {
  PENDING // inside the refund window
  APPROVED // payable
  PAID
  REVERSED // order refunded or fraudulent
}

/// A withdrawal request and its settlement. Payments happen outside the
/// system; this records what was owed, sent, and by which reference.
model AffiliatePayout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Float
  method      String?
  address     String?
  reference   String? // tx hash / bank reference, filled when marked paid
  status      PayoutStatus @default(REQUESTED)
  adminNote   String?
  requestedAt DateTime     @default(now())
  paidAt      DateTime?
  updatedAt   DateTime     @updatedAt

  commissions Commission[]

  @@index([affiliateId, status])
  @@index([status, requestedAt])
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

// ===========================================================================
// Coupons
//
// Built for test buyers first: a FREE coupon skips Paygate entirely and
// provisions the subscription through the same code path a paid order uses,
// so the licence, email, MT5 lock, compile and download all behave normally.
// Percent/fixed codes are ordinary discounts on a real payment.
// ===========================================================================

model Coupon {
  id             String      @id @default(cuid())
  code           String      @unique // stored uppercase; compared uppercase
  kind           CouponKind  @default(PERCENT)
  value          Float       @default(100) // percent for PERCENT, dollars for FIXED, ignored for FREE
  robotId        String? // null = any robot
  robot          Robot?      @relation(fields: [robotId], references: [id], onDelete: Cascade)
  tier           PricingTier? // null = any tier
  maxRedemptions Int? // null = unlimited
  redeemedCount  Int         @default(0)
  oncePerEmail   Boolean     @default(true)
  expiresAt      DateTime?
  active         Boolean     @default(true)
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  redemptions CouponRedemption[]

  @@index([active])
}

enum CouponKind {
  PERCENT
  FIXED
  FREE
}

/// One row per use. Also the audit trail for "who got this for nothing".
model CouponRedemption {
  id           String   @id @default(cuid())
  couponId     String
  coupon       Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  email        String
  userId       String?
  orderId      String?
  robotSlug    String
  tier         String
  amountBefore Float
  amountAfter  Float
  createdAt    DateTime @default(now())

  @@index([couponId, createdAt])
  @@index([email])
}

/// One row per free-trial claim, for abuse limits.
///
/// The unique index on Subscription already stops the SAME account claiming a
/// robot's trial twice; this table is what stops one person doing it from a
/// dozen throwaway addresses. Identifiers are hashed — enough to recognise a
/// repeat, not enough to identify anyone.
model TrialClaim {
  id        String   @id @default(cuid())
  robotSlug String
  ipHash    String?
  emailHash String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}
