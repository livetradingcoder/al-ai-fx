generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String?
  name                String?
  role                UserRole       @default(USER)
  shouldResetPassword Boolean        @default(false)
  isBlocked           Boolean        @default(false)
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]
  orders              Order[]
}

enum UserRole {
  USER
  ADMIN
}

model Subscription {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             PricingTier
  status           SubStatus   @default(ACTIVE)
  mt5AccountNumber String? // The MT5 account locked to this EA
  startsAt         DateTime    @default(now())
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  compilations Compilation[]
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String      @default("USD")
  status      OrderStatus @default(PENDING)
  paygateId   String?     @unique
  pricingTier PricingTier
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Compilation {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status         CompileStatus @default(PENDING)
  downloadUrl    String?

  // Retry + reaper state (Phase 1)
  attemptCount Int       @default(0)
  attemptedAt  DateTime?
  errorMessage String?

  // Upload metadata written by /complete route (Phase 1 direct-to-Blob path)
  sha256    String?
  sizeBytes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([status, attemptedAt])
}

enum PricingTier {
  FREE_TRIAL
  TEN_DAYS           // NEW — was silently downgraded to ONE_MONTH
  ONE_MONTH
  SIX_MONTHS
  ONE_YEAR           // NEW — was silently downgraded to ONE_MONTH
  LIFETIME
  LIFETIME_SOURCE    // NEW — was silently downgraded to ONE_MONTH
  SECRET_TEST_TIER
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CompileStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WorkerHeartbeat {
  id            String   @id // singleton row keyed "compiler"
  lastSeenAt    DateTime
  workerVersion String?
  updatedAt     DateTime @updatedAt
}
